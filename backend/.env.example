PORT=5000
NODE_ENV=development

# Database connection
DATABASE_URL=postgresql://postgres:<your-password>@localhost:5433/blood_bank
DB_HOST=localhost
DB_PORT=5433
DB_NAME=blood_bank
DB_USER=postgres
DB_PASSWORD=<your-password>

# Session + CSRF secrets — generate fresh random values for each environment
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET=<random 48-byte base64>
CSRF_SECRET=<random 48-byte base64>